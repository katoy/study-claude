{
  "name": "todo-app2",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:vrt": "npm run build && playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.js\" \"src/**/*.html\" \"src/**/*.css\" \"tests/**/*.js\" \"*.config.js\"",
    "format:fix": "prettier --write \"src/**/*.js\" \"src/**/*.html\" \"src/**/*.css\" \"tests/**/*.js\" \"*.config.js\"",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --write",
    "ci:check": "npm run lint && npm run format && npm run biome:check && npm run test:coverage && npm run build && npm run test:vrt",
    "record:demo": "node scripts/record-demo.js"
  },
  "dependencies": {
    "dompurify": "^3.0.9",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "esbuild": "^0.28.1",
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^9.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-unsanitized": "^4.0.2",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.2.5",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^4.1.10"
  }
}
